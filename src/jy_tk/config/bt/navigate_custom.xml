<?xml version="1.0"?>
<!--
  保留原始路径的 NavigateToPose 行为树（Jazzy / BT.CPP 4）。

  修改版：
  1. 起步规划：ComputePathToPose 只执行一次，生成初始 {path}。
  2. FollowPath 失败：清 local costmap，然后用原 path 重试。
  3. 内层清 local 一次仍失败：
     - 清 local + 清 global costmap；
     - 等待 1 秒；
     - 重新执行 ComputePathToPose，更新 {path}；
     - 再由外层 RecoveryNode 用新 path 重试 FollowPath。
  4. 不调用 stuck_escape / Spin / BackUp。
  5. 两个 RecoveryNode 使用很大的重试次数，使可恢复的规划/虚拟碰撞问题
     保持 NavigateToPose 为 RUNNING，而不是很快向巡检节点返回 STATUS_ABORTED(6)。
-->
<root main_tree_to_execute="MainTree" BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigatePreservingOriginalPath">

      <!-- 起步规划：只规划一次，生成初始 {path} -->
      <RecoveryNode number_of_retries="1000000" name="ComputeOriginalPath">
        <ComputePathToPose
          goal="{goal}"
          path="{path}"
          planner_id="GridBased"
          error_code_id="{compute_path_error_code}"/>
        <Sequence name="RecoverStartPlanning">
          <ClearEntireCostmap
            name="ClearLocalCostmapPlanning"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap
            name="ClearGlobalCostmapPlanning"
            service_name="global_costmap/clear_entirely_global_costmap"/>
          <Wait wait_duration="1.0"/>
        </Sequence>
      </RecoveryNode>

      <!-- 跟踪路径：失败后依次清图、重新规划、再跟踪 -->
      <RecoveryNode number_of_retries="1000000" name="FollowOriginalPathWithClear">
        <RecoveryNode number_of_retries="1" name="FirstLocalRecovery">
          <FollowPath
            path="{path}"
            controller_id="FollowPath"
            error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap
            name="ClearLocalCostmapFollowing"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

        <Sequence name="DeeperRecovery">
          <!-- 清 local + 清 global -->
          <ClearEntireCostmap
            name="ClearLocalCostmapDeeper"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap
            name="ClearGlobalCostmapDeeper"
            service_name="global_costmap/clear_entirely_global_costmap"/>
          <Wait wait_duration="1.0"/>
          <!-- ★ 重新规划：更新 {path}，外层 RecoveryNode 将用新 path 重试 FollowPath -->
          <ComputePathToPose
            goal="{goal}"
            path="{path}"
            planner_id="GridBased"
            error_code_id="{compute_path_error_code}"/>
        </Sequence>
      </RecoveryNode>

    </Sequence>
  </BehaviorTree>
</root>